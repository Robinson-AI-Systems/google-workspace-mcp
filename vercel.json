{
  "rewrites": [
    {
      "source": "/api/contract",
      "destination": "/api/rtc-gateway?door=contract"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/rtc-gateway?door=openapi"
    },
    {
      "source": "/api/whoami",
      "destination": "/api/rtc-gateway?door=whoami"
    },
    {
      "source": "/api/tools",
      "destination": "/api/rtc-gateway?door=tools"
    },
    {
      "source": "/api/tools/:tool",
      "destination": "/api/rtc-gateway?tool=:tool"
    },
    {
      "source": "/api/results/:result",
      "destination": "/api/rtc-gateway?result=:result"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/muse-client.json",
      "destination": "/api/well-known/muse-client"
    },
    {
      "source": "/brand/:asset",
      "destination": "/api/brand?asset=:asset"
    },
    {
      "source": "/favicon.ico",
      "destination": "/api/brand?asset=favicon.ico"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/oauth/*.js": {
      "maxDuration": 30
    },
    "api/google/*.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "live": true
    }
  }
}
