{
  "rewrites": [
    { "source": "/api/contract", "destination": "/api/rtc-gateway?door=contract" },
    { "source": "/api/openapi.json", "destination": "/api/rtc-gateway?door=openapi" },
    { "source": "/api/whoami", "destination": "/api/rtc-gateway?door=whoami" },
    { "source": "/api/tools", "destination": "/api/rtc-gateway?door=tools" },
    { "source": "/api/tools/:tool", "destination": "/api/rtc-gateway?tool=:tool" },
    { "source": "/api/results/:result", "destination": "/api/rtc-gateway?result=:result" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known/oauth-authorization-server" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known/oauth-protected-resource" },
    { "source": "/", "destination": "/api/index" }
  ],
  "functions": {
    "api/mcp.js": { "maxDuration": 60 },
    "api/oauth/*.js": { "maxDuration": 30 },
    "api/google/*.js": { "maxDuration": 30 }
  }
}
